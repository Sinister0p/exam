import java.util.Scanner;

class SortData {
    void ascending(int[] arr) {
        int n = arr.length;
        for (int i = 0; i < n - 1; i++) {
            for (int j = 0; j < n - i - 1; j++) {
                if (arr[j] > arr[j + 1]) {
                    
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
            }
        }
    }

  
    void descending(int[] arr) {
        int n = arr.length;
        for (int i = 0; i < n - 1; i++) {
            for (int j = 0; j < n - i - 1; j++) {
                if (arr[j] < arr[j + 1]) {
                 
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
            }
        }
    }

    
    void printArray(int[] arr) {
        for (int num : arr) {
            System.out.print(num + " ");
        }
        System.out.println();
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        SortData sorter = new SortData();

        System.out.print("Enter number of elements: ");
        int n = sc.nextInt();
        int[] data = new int[n];

        System.out.println("Enter " + n + " elements:");
        for (int i = 0; i < n; i++) {
            data[i] = sc.nextInt();
        }

        
        sorter.ascending(data);
        System.out.print("Ascending Order: ");
        sorter.printArray(data);

       
        sorter.descending(data);
        System.out.print("Descending Order: ");
        sorter.printArray(data);

        sc.close();
    }
}
